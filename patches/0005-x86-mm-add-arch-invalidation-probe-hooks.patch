From 0000000000000000000000000000000000000005 Mon Sep 17 00:00:00 2001
From: tlb-invalidation-lab <lab@example.com>
Date: Mon, 27 Apr 2026 10:04:00 -0700
Subject: [PATCH 5/6] x86/mm: sketch arch invalidation probe hooks

Introduce architectural classification for x86 TLB invalidation events. 
This patch adds a best-effort tracepoint to distinguish between 
instruction families (INVLPG, INVPCID, INVLPGB) based on the invalidation 
context and hardware capabilities.

This is a research-grade sketch for system-level debugging and is not 
intended for production deployment.
---
 arch/x86/mm/tlb.c          | 38 ++++++++++++++++++++++++++++++++++++++
 include/trace/events/tlb.h | 40 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 78 insertions(+)

diff --git a/arch/x86/mm/tlb.c b/arch/x86/mm/tlb.c
index 222222222222..555555555555 100644
--- a/arch/x86/mm/tlb.c
+++ b/arch/x86/mm/tlb.c
@@ -1032,6 +1032,44 @@ trace_tlb_invalidation_event(const struct flush_tlb_info *info,
 {
 	unsigned long range_size = 0;
 	int target_cpu_count = 0;
+	unsigned long range_pages = 0;
+	u8 instruction_family = TLB_INSTR_UNKNOWN;
+	bool remote = false;
 	bool broadcast = false;
 
 	if (info->end != TLB_FLUSH_ALL && info->end > info->start)
@@ -1039,12 +1077,36 @@ trace_tlb_invalidation_event(const struct flush_tlb_info *info,
 
 	if (mask)
 		target_cpu_count = cpumask_weight(mask);
+	remote = target_cpu_count > 1;
+	range_pages = range_size >> PAGE_SHIFT;
 
 	if (target_cpu_count > 1) {
+#ifdef CONFIG_X86
 #ifdef X86_FEATURE_INVLPGB
-		broadcast = boot_cpu_has(X86_FEATURE_INVLPGB);
+		if (boot_cpu_has(X86_FEATURE_INVLPGB))
+			broadcast = true;
 #endif
+#endif
 	}
 
+	/*
+	 * tlb-invalidation-lab: research patch sketch, not upstream-ready.
+	 * This is a best-effort architectural classification, not a precise
+	 * proof of which microarchitectural path completed the invalidation.
+	 */
+	if (broadcast) {
+		instruction_family = TLB_INSTR_INVLPGB;
+	} else
+#ifdef X86_FEATURE_INVPCID
+	if (boot_cpu_has(X86_FEATURE_INVPCID) &&
+	    info->end == TLB_FLUSH_ALL) {
+		instruction_family = TLB_INSTR_INVPCID;
+	} else
+#endif
+	if (range_pages == 1) {
+		instruction_family = TLB_INSTR_INVLPG;
+	}
+
 	trace_tlb_invalidation(task_pid_nr(current), task_tgid_nr(current),
 			       current->comm, info->start, info->end,
 			       range_size, target_cpu_count, broadcast);
+	trace_tlb_arch_invalidation(task_pid_nr(current), task_tgid_nr(current),
+				    current->comm, info->start, info->end,
+				    range_pages, remote, instruction_family);
 }
diff --git a/include/trace/events/tlb.h b/include/trace/events/tlb.h
index 444444444444..666666666666 100644
--- a/include/trace/events/tlb.h
+++ b/include/trace/events/tlb.h
@@ -10,6 +10,17 @@
 #undef EMe
 #define EM(a,b)		TRACE_DEFINE_ENUM(a);
 #define EMe(a,b)	TRACE_DEFINE_ENUM(a);
+
+#define TLB_INSTR_FAMILY				\
+	EM(  TLB_INSTR_UNKNOWN, "unknown" )		\
+	EM(  TLB_INSTR_INVLPG,  "invlpg" )		\
+	EM(  TLB_INSTR_INVPCID, "invpcid" )		\
+	EMe( TLB_INSTR_INVLPGB, "invlpgb" )
 
 TLB_FLUSH_REASON
+TLB_INSTR_FAMILY
 
 /*
  * Now redefine the EM() and EMe() macros to map the enums to the strings
@@ -17,6 +28,8 @@ TLB_FLUSH_REASON
 #undef EMe
 #define EM(a,b)		{ a, b },
 #define EMe(a,b)	{ a, b }
+
+TLB_INSTR_FAMILY
 
 TRACE_EVENT(tlb_flush,
@@ -66,6 +79,33 @@ TRACE_EVENT(tlb_invalidation,
 		  __entry->target_cpu_count, __entry->broadcast)
 );
 
+TRACE_EVENT(tlb_arch_invalidation,
+	TP_PROTO(pid_t pid, pid_t tgid, const char *comm,
+		 unsigned long start, unsigned long end,
+		 unsigned long range_pages, bool remote,
+		 u8 instruction_family),
+	TP_ARGS(pid, tgid, comm, start, end, range_pages,
+		remote, instruction_family),
+	TP_STRUCT__entry(
+		__field(pid_t, pid)
+		__field(pid_t, tgid)
+		__string(comm, comm)
+		__field(unsigned long, start)
+		__field(unsigned long, end)
+		__field(unsigned long, range_pages)
+		__field(bool, remote)
+		__field(u8, instruction_family)
+	),
+	TP_fast_assign(
+		__entry->pid = pid;
+		__entry->tgid = tgid;
+		__assign_str(comm, comm);
+		__entry->start = start;
+		__entry->end = end;
+		__entry->range_pages = range_pages;
+		__entry->remote = remote;
+		__entry->instruction_family = instruction_family;
+	),
+	TP_printk("pid=%d tgid=%d comm=%s start=0x%lx end=0x%lx range_pages=%lu remote=%d instruction_family=%s",
+		  __entry->pid, __entry->tgid, __get_str(comm),
+		  __entry->start, __entry->end, __entry->range_pages,
+		  __entry->remote, __print_symbolic(__entry->instruction_family, TLB_INSTR_FAMILY))
+);
