From 0000000000000000000000000000000000000006 Mon Sep 17 00:00:00 2001
From: tlb-invalidation-lab <lab@example.com>
Date: Mon, 27 Apr 2026 10:05:00 -0700
Subject: [PATCH 6/6] arm64/mm: sketch arch invalidation probe hooks

This is a lab-oriented sketch showing where arm64 TLBI paths could emit
scope and range-related observability fields. It is intentionally not
presented as upstream-ready code.
---
 arch/arm64/include/asm/tlbflush.h | 19 +++++++++++++++++++
 arch/arm64/mm/flush.c             |  3 +++
 include/trace/events/tlb.h        | 25 +++++++++++++++++++++++++
 3 files changed, 47 insertions(+)

diff --git a/arch/arm64/include/asm/tlbflush.h b/arch/arm64/include/asm/tlbflush.h
index 777777777777..888888888888 100644
--- a/arch/arm64/include/asm/tlbflush.h
+++ b/arch/arm64/include/asm/tlbflush.h
@@ -12,6 +12,7 @@
 #include <linux/mm_types.h>
 #include <linux/sched.h>
 #include <linux/mmu_notifier.h>
+#include <trace/events/tlb.h>
 #include <asm/cputype.h>
 #include <asm/mmu.h>
 
@@ -351,6 +352,17 @@ static inline void __flush_tlb_range(struct vm_area_struct *vma,
 	dsb(ishst);
 	asid = ASID(vma->vm_mm);
 
+	/*
+	 * tlb-invalidation-lab: research patch sketch, not upstream-ready.
+	 * Avoid per-page trace emission to prevent trace buffer flooding.
+	 * Emit a single event per invalidation range and let userspace do
+	 * the time correlation and rate analysis.
+	 */
+	trace_tlb_arm64_invalidation(task_pid_nr(current), task_tgid_nr(current),
+				     current->comm, start, end, pages,
+				     last_level ? TLB_ARM64_SCOPE_LOCAL :
+				     TLB_ARM64_SCOPE_INNER_SHAREABLE);
+
 	if (last_level)
 		__flush_tlb_range_op(vale1is, start, pages, stride, asid, tlb_level, true);
 	else
diff --git a/arch/arm64/mm/flush.c b/arch/arm64/mm/flush.c
index 999999999999..aaaaaaaaaaaa 100644
--- a/arch/arm64/mm/flush.c
+++ b/arch/arm64/mm/flush.c
@@ -1,4 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
+#define CREATE_TRACE_POINTS
+#include <trace/events/tlb.h>
+
 /*
  * Copyright (C) 2002 ARM Ltd.
  */
diff --git a/include/trace/events/tlb.h b/include/trace/events/tlb.h
index 666666666666..999999999999 100644
--- a/include/trace/events/tlb.h
+++ b/include/trace/events/tlb.h
@@ -22,6 +22,12 @@ TLB_INSTR_FAMILY
+#define TLB_ARM64_SCOPE					\
+	EM(  TLB_ARM64_SCOPE_LOCAL, "local" )		\
+	EM(  TLB_ARM64_SCOPE_INNER_SHAREABLE, "inner-shareable" ) \
+	EMe( TLB_ARM64_SCOPE_SYSTEM, "system" )
+
+TLB_ARM64_SCOPE
+
 TRACE_EVENT(tlb_flush,
@@ -106,6 +112,25 @@ TRACE_EVENT(tlb_arch_invalidation,
 		  __entry->remote, __print_symbolic(__entry->instruction_family, TLB_INSTR_FAMILY))
 );
 
+TRACE_EVENT(tlb_arm64_invalidation,
+	TP_PROTO(pid_t pid, pid_t tgid, const char *comm,
+		 unsigned long start, unsigned long end,
+		 unsigned long range_pages, u8 tlbi_scope),
+	TP_ARGS(pid, tgid, comm, start, end, range_pages, tlbi_scope),
+	TP_STRUCT__entry(
+		__field(pid_t, pid)
+		__field(pid_t, tgid)
+		__string(comm, comm)
+		__field(unsigned long, start)
+		__field(unsigned long, end)
+		__field(unsigned long, range_pages)
+		__field(u8, tlbi_scope)
+	),
+	TP_fast_assign(
+		__entry->pid = pid;
+		__entry->tgid = tgid;
+		__assign_str(comm, comm);
+		__entry->start = start;
+		__entry->end = end;
+		__entry->range_pages = range_pages;
+		__entry->tlbi_scope = tlbi_scope;
+	),
+	TP_printk("pid=%d tgid=%d comm=%s start=0x%lx end=0x%lx range_pages=%lu tlbi_scope=%s",
+		  __entry->pid, __entry->tgid, __get_str(comm),
+		  __entry->start, __entry->end, __entry->range_pages,
+		  __print_symbolic(__entry->tlbi_scope, TLB_ARM64_SCOPE))
+);
-- 
