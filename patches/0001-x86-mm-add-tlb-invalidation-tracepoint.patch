From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: tlb-invalidation-lab <lab@example.com>
Date: Mon, 27 Apr 2026 10:00:00 -0700
Subject: [PATCH 1/4] x86/mm: add tlb invalidation tracepoint

Add a high-signal tracepoint for TLB invalidation events on x86. This 
event captures invalidation ranges, fanout (target CPU count), and 
broadcast capability hints.

To minimize overhead in the hot path, the expensive architectural 
calculations (such as cpumask_weight) are gated behind a 
trace_tlb_invalidation_enabled() check, ensuring zero cost when tracing 
is inactive.

This is a research-grade observability artifact and is not intended for 
upstream submission.
---
 arch/x86/mm/tlb.c          | 33 ++++++++++++++++++++++++++++++++-
 include/trace/events/tlb.h | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+), 1 deletion(-)

diff --git a/arch/x86/mm/tlb.c b/arch/x86/mm/tlb.c
index 111111111111..222222222222 100644
--- a/arch/x86/mm/tlb.c
+++ b/arch/x86/mm/tlb.c
@@ -8,8 +8,12 @@
 #include <linux/interrupt.h>
 #include <linux/export.h>
 #include <linux/cpu.h>
+#include <linux/cpumask.h>
 #include <linux/debugfs.h>
 #include <linux/sched/smt.h>
+#define CREATE_TRACE_POINTS
+#include <trace/events/tlb.h>
+
 #include <linux/task_work.h>
 #include <linux/mmu_notifier.h>
 
@@ -1028,6 +1032,34 @@ static bool tlb_is_not_lazy(int cpu, void *data)
 	return !per_cpu(cpu_tlbstate_shared.is_lazy, cpu);
 }
 
+static __always_inline void
+trace_tlb_invalidation_event(const struct flush_tlb_info *info,
+			     const struct cpumask *mask)
+{
+	unsigned long range_size = 0;
+	int target_cpu_count = 0;
+	bool broadcast = false;
+
+	if (!trace_tlb_invalidation_enabled())
+		return;
+
+	/*
+	 * tlb-invalidation-lab: research patch sketch, not upstream-ready.
+	 * cpumask_weight is O(N); we only pay this cost when tracing is active.
+	 */
+	if (info->end != TLB_FLUSH_ALL && info->end > info->start)
+		range_size = info->end - info->start;
+
+	if (mask)
+		target_cpu_count = cpumask_weight(mask);
+
+	if (target_cpu_count > 1) {
+#ifdef X86_FEATURE_INVLPGB
+		broadcast = boot_cpu_has(X86_FEATURE_INVLPGB);
+#endif
+	}
+
+	trace_tlb_invalidation(task_pid_nr(current), task_tgid_nr(current),
+			       current->comm, info->start, info->end,
+			       range_size, target_cpu_count, broadcast);
+}
+
 DEFINE_PER_CPU_SHARED_ALIGNED(struct tlb_state_shared, cpu_tlbstate_shared);
 EXPORT_PER_CPU_SYMBOL(cpu_tlbstate_shared);
 
@@ -1044,7 +1076,8 @@ STATIC_NOPV void native_flush_tlb_multi(const struct cpumask *cpumask,
 		trace_tlb_flush(TLB_REMOTE_SEND_IPI,
 				(info->end - info->start) >> PAGE_SHIFT);
 
-	/*
+	trace_tlb_invalidation_event(info, cpumask);
+	/*
 	 * If no page tables were freed, we can skip sending IPIs to
 	 * CPUs in lazy TLB mode. They will flush the CPU themselves
 	 * at the next context switch.
diff --git a/include/trace/events/tlb.h b/include/trace/events/tlb.h
index 333333333333..444444444444 100644
--- a/include/trace/events/tlb.h
+++ b/include/trace/events/tlb.h
@@ -34,6 +34,38 @@ TRACE_EVENT(tlb_flush,
 		__entry->reason)
 );
 
+TRACE_EVENT(tlb_invalidation,
+	TP_PROTO(pid_t pid, pid_t tgid, const char *comm,
+		 unsigned long start, unsigned long end,
+		 unsigned long range_size, int target_cpu_count,
+		 bool broadcast),
+	TP_ARGS(pid, tgid, comm, start, end, range_size,
+		target_cpu_count, broadcast),
+	TP_STRUCT__entry(
+		__field(pid_t, pid)
+		__field(pid_t, tgid)
+		__string(comm, comm)
+		__field(unsigned long, start)
+		__field(unsigned long, end)
+		__field(unsigned long, range_size)
+		__field(int, target_cpu_count)
+		__field(bool, broadcast)
+	),
+	TP_fast_assign(
+		__entry->pid = pid;
+		__entry->tgid = tgid;
+		__assign_str(comm, comm);
+		__entry->start = start;
+		__entry->end = end;
+		__entry->range_size = range_size;
+		__entry->target_cpu_count = target_cpu_count;
+		__entry->broadcast = broadcast;
+	),
+	TP_printk("pid=%d tgid=%d comm=%s start=0x%lx end=0x%lx bytes=%lu target_cpu_count=%d broadcast=%d",
+		  __entry->pid, __entry->tgid, __get_str(comm),
+		  __entry->start, __entry->end, __entry->range_size,
+		  __entry->target_cpu_count, __entry->broadcast)
+);
+
 #endif /* _TRACE_TLB_H */
 
 /* This part must be outside protection */
-- 
