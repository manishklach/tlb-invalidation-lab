From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: tlb-invalidation-lab <lab@example.com>
Date: Mon, 27 Apr 2026 10:00:00 -0700
Subject: [PATCH 1/4] x86/mm: add tlb invalidation tracepoint

Add an x86-focused tracepoint for invalidation ranges so that users can
measure invalidation frequency, bytes invalidated, and rough fanout
without adding expensive formatting to the hot path.

The event is intended for observability and attribution. It does not
change invalidation behavior.
---
 arch/x86/mm/tlb.c            | 28 ++++++++++++++++++++++++++++
 include/trace/events/tlb.h   | 47 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 75 insertions(+)
 create mode 100644 include/trace/events/tlb.h

diff --git a/arch/x86/mm/tlb.c b/arch/x86/mm/tlb.c
index 111111111111..222222222222 100644
--- a/arch/x86/mm/tlb.c
+++ b/arch/x86/mm/tlb.c
@@ -10,6 +10,10 @@
 #include <linux/mm.h>
 #include <linux/smp.h>
 #include <linux/cpumask.h>
+#define CREATE_TRACE_POINTS
+#include <trace/events/tlb.h>
+
 #include <asm/tlbflush.h>
+#include <asm/cpufeature.h>
 #include <asm/paravirt.h>
 
@@ -1012,6 +1016,31 @@ static void flush_tlb_func(void *info)
 	flush_tlb_local();
 }
 
+static __always_inline void trace_tlb_invalidation_event(unsigned long start,
+							 unsigned long end,
+							 const struct cpumask *mask)
+{
+	unsigned long range_size;
+	int cpu_count = 0;
+	bool broadcast = false;
+
+	if (end <= start)
+		range_size = 0;
+	else
+		range_size = end - start;
+
+	if (mask)
+		cpu_count = cpumask_weight(mask);
+
+	/*
+	 * Heuristic hint only: report capability-backed likelihood for
+	 * multi-CPU invalidations without claiming the exact hardware path.
+	 */
+	if (cpu_count > 1) {
+#ifdef X86_FEATURE_INVLPGB
+		broadcast = boot_cpu_has(X86_FEATURE_INVLPGB);
+#endif
+	}
+
+	trace_tlb_invalidation(task_pid_nr(current), task_tgid_nr(current),
+			       current->comm, start, end, range_size,
+			       cpu_count, broadcast);
+}
+
 static void native_flush_tlb_multi(const struct cpumask *cpumask,
 				   const struct flush_tlb_info *info)
 {
@@ -1032,6 +1061,8 @@ static void native_flush_tlb_multi(const struct cpumask *cpumask,
 	if (cpumask_empty(cpumask))
 		return;
 
+	trace_tlb_invalidation_event(info->start, info->end, cpumask);
+
 	on_each_cpu_mask(cpumask, flush_tlb_func, (void *)info, 1);
 }
 
diff --git a/include/trace/events/tlb.h b/include/trace/events/tlb.h
new file mode 100644
index 000000000000..333333333333
--- /dev/null
+++ b/include/trace/events/tlb.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM tlb
+
+#if !defined(_TRACE_TLB_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_TLB_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(tlb_invalidation,
+	TP_PROTO(pid_t pid, pid_t tgid, const char *comm,
+		 unsigned long start, unsigned long end,
+		 unsigned long range_size, int target_cpu_count,
+		 bool broadcast),
+	TP_ARGS(pid, tgid, comm, start, end, range_size,
+		target_cpu_count, broadcast),
+	TP_STRUCT__entry(
+		__field(pid_t, pid)
+		__field(pid_t, tgid)
+		__string(comm, comm)
+		__field(unsigned long, start)
+		__field(unsigned long, end)
+		__field(unsigned long, range_size)
+		__field(int, target_cpu_count)
+		__field(bool, broadcast)
+	),
+	TP_fast_assign(
+		__entry->pid = pid;
+		__entry->tgid = tgid;
+		__assign_str(comm, comm);
+		__entry->start = start;
+		__entry->end = end;
+		__entry->range_size = range_size;
+		__entry->target_cpu_count = target_cpu_count;
+		__entry->broadcast = broadcast;
+	),
+	TP_printk("pid=%d tgid=%d comm=%s start=0x%lx end=0x%lx bytes=%lu target_cpu_count=%d broadcast=%d",
+		  __entry->pid, __entry->tgid, __get_str(comm),
+		  __entry->start, __entry->end, __entry->range_size,
+		  __entry->target_cpu_count, __entry->broadcast)
+);
+
+#endif /* _TRACE_TLB_H */
+
+#include <trace/define_trace.h>
-- 
2.43.0
