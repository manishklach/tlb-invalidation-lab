From 0000000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: tlb-invalidation-lab <lab@example.com>
Date: Mon, 27 Apr 2026 10:02:00 -0700
Subject: [PATCH 3/4] proc: add experimental per-process tlb stats sketch

This patch is intentionally labeled experimental. It shows one possible
shape for process-local aggregation but should not be treated as the
preferred observability path. Userspace aggregation from tracepoints is
lower risk and less invasive.
---
 fs/proc/base.c            | 39 +++++++++++++++++++++++++++++++++++++++
 include/linux/mm_types.h  |  6 ++++++
 2 files changed, 45 insertions(+)

diff --git a/fs/proc/base.c b/fs/proc/base.c
index 777777777777..888888888888 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -130,6 +130,7 @@ enum pid_directory_inos {
 	PROC_TID_CHILDREN,
 	PROC_TID_STACK,
 	PROC_TID_SYSCALL,
+	PROC_TID_TLB_STATS,
 };
 
 static const struct pid_entry tgid_base_stuff[] = {
@@ -169,6 +170,7 @@ static const struct pid_entry tgid_base_stuff[] = {
 	ONE("stack", S_IRUSR, proc_pid_stack_operations),
 	ONE("syscall", S_IRUSR, proc_pid_syscall_operations),
 	ONE("cmdline", S_IRUGO, proc_pid_cmdline_operations),
+	ONE("tlb_stats", S_IRUGO, proc_pid_tlb_stats_operations),
 };
 
 static int proc_pid_personality(struct seq_file *m, struct pid_namespace *ns,
@@ -1845,6 +1847,40 @@ static int proc_pid_syscall(struct seq_file *m, struct pid_namespace *ns,
 	return 0;
 }
 
+static int proc_pid_tlb_stats(struct seq_file *m, struct pid_namespace *ns,
+			      struct pid *pid, struct task_struct *task)
+{
+	struct mm_struct *mm = get_task_mm(task);
+
+	if (!mm)
+		return -ESRCH;
+
+	seq_printf(m, "experimental: 1\n");
+	seq_printf(m, "preferred_source: tracepoints\n");
+	seq_printf(m, "tlb_invalidations: %llu\n",
+		   (unsigned long long)atomic64_read(&mm->tlb_invalidations));
+	seq_printf(m, "tlb_bytes_invalidated: %llu\n",
+		   (unsigned long long)atomic64_read(&mm->tlb_bytes_invalidated));
+	seq_printf(m, "tlb_remote_fanout: %llu\n",
+		   (unsigned long long)atomic64_read(&mm->tlb_remote_fanout));
+
+	mmput(mm);
+	return 0;
+}
+
+static int proc_pid_tlb_stats_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, proc_pid_tlb_stats, pde_data(inode));
+}
+
+static const struct proc_ops proc_pid_tlb_stats_operations = {
+	.proc_open	= proc_pid_tlb_stats_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
diff --git a/include/linux/mm_types.h b/include/linux/mm_types.h
index 999999999999..aaaaaaaaaaaa 100644
--- a/include/linux/mm_types.h
+++ b/include/linux/mm_types.h
@@ -720,6 +720,12 @@ struct mm_struct {
 	 */
 	unsigned long flags;
 
+	/*
+	 * Experimental observability-only counters.
+	 * Prefer userspace aggregation from tracepoints for production use.
+	 */
+	atomic64_t tlb_invalidations;
+	atomic64_t tlb_bytes_invalidated;
+	atomic64_t tlb_remote_fanout;
 	struct core_state *core_state;
 } ____cacheline_aligned_in_smp;
-- 
